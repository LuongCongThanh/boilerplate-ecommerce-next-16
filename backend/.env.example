# Chép thành .env: cp .env.example .env (08 mục 2.3). Chỉ chứa biến đã khai báo trong config/env.py.

# Từ M0
# Chỉ có tác dụng trong Compose (nạp .env vào biến môi trường); chạy trên máy thì export
# hoặc dùng mặc định local của manage.py
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-only-change-me
# Theo output của scripts/setup/postgres.sh
DATABASE_URL=postgres://fashion:fashion@localhost:5432/fashion
# Compose dùng để trỏ host.docker.internal
PG_PORT=5432
# Cổng Redis của Compose mở ra máy
REDIS_PORT=6380
# .env viết cho máy; container ghi đè REDIS_URL, EMAIL_HOST, DATABASE_URL trong docker-compose.yml
REDIS_URL=redis://localhost:6380/0
EMAIL_HOST=localhost
EMAIL_PORT=1025
# kid:secret, nhiều khoá cách nhau bằng dấu phẩy, khoá đầu dùng cho giá trị mới, không xoá
# khoá cũ (ADR 0016). `manage.py check --deploy` đòi mỗi secret dài từ 32 byte
PII_HMAC_KEYS=local-pii-1:local-pii-secret
STOREFRONT_ORIGIN=http://localhost:3000
# 1 hoặc 2 secret cách nhau bằng dấu phẩy; 2 khi đang xoay, Next.js gửi một (05 mục 5)
BFF_SHARED_SECRET=local-bff-secret
